{
  "client": {
    "token": {
      "hmac_secret_key": "__SECRET__"
    },
    "insecure": false,
    "allowed_origins": [
      "*"
    ]
  },
  "http_api": {
    "key": "__API_KEY__"
  },
  "admin": {
    "enabled": false
  },
  "channel": {
    "proxy": {
      "subscribe": {
        "endpoint": "__PROXY__/api/chats/subscribe-proxy",
        "http": {
          "static_headers": {
            "X-Internal-Token": "__INTERNAL__"
          }
        }
      }
    },
    "without_namespace": {
      "subscribe_proxy_enabled": true
    },
    "namespaces": [
      {
        "name": "user",
        "subscribe_proxy_enabled": true,
        "presence": true
      },
      {
        "name": "partner",
        "subscribe_proxy_enabled": true,
        "presence": true
      },
      {
        "name": "thread",
        "subscribe_proxy_enabled": true,
        "presence": true
      }
    ]
  }
}
