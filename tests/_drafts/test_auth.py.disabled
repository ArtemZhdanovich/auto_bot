# tests/api/test_auth.py

def test_login_code_bound_to_session(client, redis, monkeypatch):
    """GET /telegram/link/{code} без cookie state → 401."""
    r = client.post("/api/auth/telegram/link")
    assert r.status_code == 200
    code = r.json()["code"]
    # без cookie — не отдаём даже статус
    r2 = client.get(f"/api/auth/telegram/link/{code}")
    assert r2.status_code == 401


def test_login_code_with_wrong_cookie_rejected(client, redis):
    r = client.post("/api/auth/telegram/link")
    code = r.json()["code"]
    client.cookies.set("tglogin_state", "wrong-state")
    r2 = client.get(f"/api/auth/telegram/link/{code}")
    assert r2.status_code == 401


def test_login_code_with_matching_cookie_pending(client, redis):
    r = client.post("/api/auth/telegram/link")  # cookie ставится автоматически
    code = r.json()["code"]
    r2 = client.get(f"/api/auth/telegram/link/{code}")
    assert r2.status_code == 200
    assert r2.json()["status"] == "pending"


def test_login_code_confirm_keeps_state_hash(client, redis):
    """confirm не должен затирать state_hash, иначе GET не сможет проверить cookie."""
    r = client.post("/api/auth/telegram/link")
    code = r.json()["code"]
    client.post(
        "/api/auth/telegram/link/confirm",
        json={"code": code, "telegram_id": 111},
        headers={"X-Internal-Token": "test-internal"},
    )
    r2 = client.get(f"/api/auth/telegram/link/{code}")
    assert r2.status_code == 200
    assert "access_token" in r2.json()


def test_login_code_one_time(client, redis):
    """Повторный GET после успешного claim → expired."""
    r = client.post("/api/auth/telegram/link")
    code = r.json()["code"]
    client.post(
        "/api/auth/telegram/link/confirm",
        json={"code": code, "telegram_id": 111},
        headers={"X-Internal-Token": "test-internal"},
    )
    r1 = client.get(f"/api/auth/telegram/link/{code}")
    assert "access_token" in r1.json()
    r2 = client.get(f"/api/auth/telegram/link/{code}")
    assert r2.json()["status"] == "expired"


