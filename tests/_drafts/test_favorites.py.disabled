# tests/api/test_favorites.py

# --- list_favorites: пагинация ------------------------------------

@pytest.mark.asyncio
async def test_list_favorites_paginated(client, auth_headers, many_favorites):
    """Пагинация: limit/offset работают, max 100."""
    r = await client.get("/api/favorites?limit=10&offset=0", headers=auth_headers)
    assert r.status_code == 200
    assert len(r.json()) <= 10


@pytest.mark.asyncio
async def test_list_favorites_limit_capped(client, auth_headers):
    r = await client.get("/api/favorites?limit=1000", headers=auth_headers)
    assert r.status_code == 422  # le=100


@pytest.mark.asyncio
async def test_list_favorites_first_price_uses_distinct_on(
    client, auth_headers, favorites_with_history,
):
    """История цен: возвращается только первая точка по каждому листингу."""
    r = await client.get("/api/favorites", headers=auth_headers)
    items = r.json()
    # У каждого — first_price из самой ранней записи
    assert all("first_price" in item for item in items)


