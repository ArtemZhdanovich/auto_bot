# ============================================================
# auto_bot — переменные окружения
# Зеркало app/core/config.py (Settings) + интерполяция docker-compose.yml
# для postgres и RAG-микросервиса (services/rag).
# Значения по умолчанию совпадают с кодом; закомментированное можно не задавать.
# ============================================================

# --- App ---
APP_ENV=dev                      # dev | prod
APP_SECRET_KEY=change-me
# Секрет внутренних эндпоинтов (админка /admin/*, X-Internal-Token);
# пусто = используется APP_SECRET_KEY
INTERNAL_TOKEN=
APP_BASE_URL=http://localhost:8000
MINIAPP_URL=http://localhost:8080

# --- Bot ---
BOT_TOKEN=
# Юзернейм бота (без @) для «Войти через Telegram» на сайте; пусто = выключен
BOT_USERNAME=
                   # юзернейм бота (без @) для «Войти через Telegram» на сайте; пусто = вход через ТГ выключен
ADMIN_CHAT_ID=                   # алерты/уведомления админу; пусто = не задан
MANAGER_CHAT_ID=                 # уведомления менеджеру; пусто = не задан

# --- DB ---
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/autoselect
# Пароль postgres в docker-compose (POSTGRES_PASSWORD); менять вместе с DATABASE_URL
DB_PASSWORD=app

# --- Redis / RabbitMQ ---
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# --- Auth (значения по умолчанию в коде) ---
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_TTL_SEC=3600
# REFRESH_TOKEN_TTL_SEC=2592000
# INIT_DATA_MAX_AGE_SEC=86400

# --- LLM (этап 3): основной провайдер GLM (Zhipu) ---
# glm | anthropic | ollama | mock ("mock" — тесты/dev без LLM)
LLM_PROVIDER=glm
GLM_API_KEY=
# api.z.ai — международный эндпоинт; для ключей open.bigmodel.cn:
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_BASE_URL=https://api.z.ai/api/paas/v4
ANTHROPIC_API_KEY=
LLM_DEFAULT_MODEL=glm-4.6
LLM_ADVANCED_MODEL=glm-4.6
# LLM_BASE_URL=                  # переопределение (Ollama: http://localhost:11434/v1)
LLM_TEMPERATURE=0.2

# --- AI-диалог (значения по умолчанию в коде) ---
# DIALOG_TTL_SEC=86400            # жизнь диалога, 24 ч
# DIALOG_HISTORY_LEN=8            # последних N сообщений в контексте
# FAQ_CACHE_TTL_SEC=86400

# --- RAG-сервис (пустой RAG_SERVICE_URL = выключен, агент отвечает через LLM) ---
RAG_SERVICE_URL=http://localhost:8100
RAG_API_TOKEN=change-me-rag
RAG_ENABLED=true
# RAG_TIMEOUT_SEC=5
# RAG_CACHE_TTL_SEC=3600         # кэш ответов в Redis
# RAG_CONFIDENCE_THRESHOLD=0.6   # ниже — fallback на LLM
# RAG_CB_FAIL_THRESHOLD=5        # circuit breaker: N ошибок подряд
# RAG_CB_COOLDOWN_SEC=300        # пауза после открытия CB

# --- RAG-микросервис (services/rag; читается docker-compose.yml) ---
# общий секрет JWT, которым rag-api подписывает запросы к worker (пусто = APP_SECRET_KEY)
RAG_JWT_SECRET=
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_LLM_PROVIDER=glm
RAG_LLM_MODEL=glm-4.6

# --- Уведомления (значения по умолчанию в коде) ---
# NOTIFY_RATE_LIMIT_SEC=30        # не чаще 1 сообщения / 30 сек
# NOTIFY_SCAN_WINDOW_SEC=1800     # «свежие» объявления для сканирования фильтров
# NOTIFY_SENT_TTL_SEC=604800      # notified:{uid}:{lid}, 7 дней
# DIGEST_MAX_CARDS=5              # 3–5 карточек в дайджесте
# NOTIFY_QUIET_HOURS_DEFAULT=     # глобальные тихие часы "23:00-08:00"
# STALE_MAX_AGE_DAYS=3            # не виден N дней → объявление исчезло (stale-cron)

# --- Перевод тайтлов (PLAN.md, фаза 5; сервис services/translate) ---
TRANSLATE_ENABLED=false          # feature flag; выключен → показывается оригинальный title
TRANSLATE_SERVICE_URL=http://localhost:8200
# TRANSLATE_API_TOKEN=           # Bearer; должен совпадать с API_TOKEN контейнера translate
# TRANSLATE_TIMEOUT_SEC=30       # NLLB на CPU небыстрый
# TRANSLATE_BATCH_SIZE=32
# TRANSLATE_CACHE_TTL_SEC=2592000  # Redis tr:{tgt}:{src}:{sha1}, 30 дней
# TRANSLATE_CB_FAIL_THRESHOLD=3  # circuit breaker: N ошибок подряд → пауза
# TRANSLATE_CB_COOLDOWN_SEC=300
# TRANSLATE_TARGET_LANG=rus_Cyrl
# NLLB-код исходника по источнику (JSON); отсутствующие источники — auto-детект
# TRANSLATE_SOURCE_LANGS={"encar": "kor_Hang", "kcar": "kor_Hang", "che168": "zho_Hans"}

# Биллинг партнёров (P2-14): CPL-тарифы по планам, USD за лид (JSON).
# Индивидуальный cpl_rate партнёра (partner_accounts.cpl_rate) перекрывает план.
# PARTNER_CPL_RATES={"starter": 5.0, "pro": 3.0, "salon": 2.0}

# Token Bucket Telegram (ТЗ п. 12.6): ~30 msg/s глобально, ~1 msg/s на чат.
# 0 = лимитер выключен; Redis недоступен → отправка не блокируется (fail-open).
# TELEGRAM_RATE_GLOBAL_PER_SEC=30
# TELEGRAM_RATE_CHAT_PER_SEC=1

# --- Сервис перевода (services/translate; читается docker-compose.yml) ---
TRANSLATE_MODEL=facebook/nllb-200-distilled-600M
TRANSLATE_API_TOKEN=

# --- S3/MinIO: raw payload в холодное хранилище (PLAN.md, фаза 6) ---
# Выключено (флаг или пустой endpoint) → сырые ответы адаптеров не пишутся,
# объявления сохраняются как обычно. Включено → JSON в MinIO, в listings.raw_key
# только ключ объекта; retention-крон чистит объекты старше RAW_RETENTION_DAYS.
RAW_PAYLOAD_ENABLED=false
S3_ENDPOINT_URL=http://minio:9000   # локально без docker: http://localhost:9000
S3_BUCKET=raw-payloads
S3_ACCESS_KEY=minioadmin            # = MINIO_ROOT_USER в docker-compose
S3_SECRET_KEY=minioadmin            # = MINIO_ROOT_PASSWORD в docker-compose
S3_REGION=us-east-1
# RAW_RETENTION_DAYS=180
# RAW_PRESIGN_TTL_SEC=600           # presigned GET для админки, 10 мин
# Фотографии лотов рынка (07 §1): bucket public-read, публичный URL
# собирается из S3_PUBLIC_URL — адрес MinIO, доступный браузеру
# (minio из docker-сети с хоста недостижим).
S3_PHOTOS_BUCKET=market-photos
S3_PUBLIC_URL=http://localhost:9000

# --- Микросервисы (профиль micro: gateway маршрутизирует /api/*) ---
# Адреса доменных сервисов для gateway. В docker-compose задаются
# автоматически (http://identity:8101, ...); здесь — значения для локального запуска.
# GATEWAY_TIMEOUT_SEC=15
SVC_IDENTITY_URL=http://localhost:8101
SVC_CATALOG_URL=http://localhost:8102
SVC_BILLING_URL=http://localhost:8103
SVC_PARTNERS_URL=http://localhost:8104
SVC_DIALOG_URL=http://localhost:8105
SVC_ADMIN_URL=http://localhost:8106
SVC_CHAT_URL=http://localhost:8107

# --- Centrifugo (чаты/рынок, редизайн часть 5) ---
# Адрес сервера centrifugo для publish-API и браузерных клиентов.
# В docker-compose перекрывается на http://centrifugo:8008.
CENTRIFUGO_URL=http://localhost:8008
# HMAC-ключ подписи браузерных JWT (в контейнере centrifugo попадает в
# CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY) — тот же секрет у бэкенда.
CENTRIFUGO_SECRET=change-me
# Ключ HTTP API публикации (Authorization: apikey ...; в контейнере
# centrifugo — CENTRIFUGO_HTTP_API_KEY). Также принимается заголовком
# X-Internal-Token на /api/chats/subscribe-proxy (см. configs/centrifugo.json,
# там статический заголовок должен совпадать с этим значением).
CENTRIFUGO_HTTP_API_KEY=change-me

# --- Alerting / мониторинг (этап 8): алерты в Telegram на ADMIN_CHAT_ID ---
ALERTS_ENABLED=true
# ALERT_DEDUP_TTL_SEC=1800
# DLQ_ALERT_THRESHOLD=10
# HEALTH_CHECK_INTERVAL_SEC=300
# SOURCE_CB_ERROR_STREAK=5        # ошибок подряд до отключения источника

# --- Monitoring ---
SENTRY_DSN=
LOG_LEVEL=INFO

# --- Партнёрский контур (P2-10): API для ИП/перекупов, покупающих лиды (CPL) ---
# Rate limit на партнёрский ключ (запросов/мин, fixed window в Redis)
PARTNER_RATE_LIMIT_PER_MIN=60

# --- Постквантовое шифрование документов at-rest (ML-KEM-768 + X25519) ---
# Ключи сгенерировать: uv run python -c "from app.core.pq_crypto import generate_keypair; print(generate_keypair())"
ENCRYPT_DOCUMENTS=false
PQ_ENCRYPTION_PUBLIC_KEY=
PQ_ENCRYPTION_PRIVATE_KEY=

# --- Прокси DataImpulse (опционально) ---
# Включается, если источники глушат по IP/гео. Логин и пароль прокси-юзера
# из дашборда DataImpulse. Заданы оба → источники с capabilities.use_proxy=true
# (che168) ходят через шлюз; остальные — напрямую. Пусто = без прокси.
# Формат: http://<user>__cr.<geo>;sessid.<id>:<pass>@gw.dataimpulse.com:823
PROXY_DATAIMPULSE_USER=
PROXY_DATAIMPULSE_PASS=
PROXY_DATAIMPULSE_HOST=gw.dataimpulse.com
# 823 = HTTPS, 824 = SOCKS5
PROXY_DATAIMPULSE_PORT=823
# Страна выхода, cr.*: cn / cn,de / us ... (пусто = весь мир)
PROXY_DATAIMPULSE_GEO=
# 0 = новый IP на каждый запрос; иначе sticky-окно в секундах (1800 = ~30 мин)
PROXY_DATAIMPULSE_STICKY_TTL_SEC=1800
# После N ошибок соединения подряд шлюз пауза на N сек (ходим напрямую)
PROXY_DATAIMPULSE_FAIL_THRESHOLD=5
PROXY_DATAIMPULSE_FAIL_COOLDOWN_SEC=300


